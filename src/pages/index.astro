---
import Layout from "../layouts/Layout.astro";
import { MapPin, Globe, Phone, Mail } from "lucide-astro";

const BASE_URL = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Layout title="Nathan Charles Czapnik Business English Tutor">

  <header class="navbar">

    <div class="logo">
      <span>N</span>
      <span class="divider"></span>
      <span>C</span>
    </div>

    <nav>
      <a href={`${BASE_URL}o-mnie`}>O mnie</a>
      <a href={`${BASE_URL}oferta`}>Oferta</a>
      <a href={`${BASE_URL}blog`}>Blog</a>
      <a href={`${BASE_URL}faq`}>FAQ</a>
      <a href={`${BASE_URL}kontakt`}>Kontakt</a>
    </nav>

  </header>

  <main>

    <section class="hero" id="hero">

      <div class="hero-left">

        <h1>
          Nathan Charles<br />
          Czapnik
        </h1>

        <h2>
          Business English Tutor
        </h2>

        <div class="line"></div>

        <p class="intro">
          Indywidualne lekcje języka angielskiego prowadzone
          w spokojnej, praktycznej atmosferze –
          dla dzieci, młodzieży i dorosłych.
        </p>

        <div class="info">

          <p class="info-item">
            <MapPin size={20} />
            <span>Dojeżdżam do ucznia – Sandomierz i okolice.</span>
          </p>

          <p class="info-item">
            <Globe size={20} />
            <span>Możliwość prowadzenia zajęć online.</span>
          </p>

        </div>

        <div class="buttons">

          <a class="button-primary" href="tel:+48577970929">
            <Phone size={18} />
            <span>Zadzwoń</span>
          </a>

          <a
            class="button-secondary"
            href="mailto:nathancharlesczapnik@gmail.com"
          >
            <Mail size={18} />
            <span>Napisz e-mail</span>
          </a>

        </div>

      </div>

      <div class="hero-right">

        <div class="roundel-mark" aria-hidden="true">
          <span class="roundel-ring"></span>
          <span class="roundel-bar"></span>
        </div>

        <div class="map-area">
          <img
            src={`${BASE_URL}images/english-map.png`}
            alt="Mapa przedstawiająca rozwój umiejętności językowych"
            class="english-map"
          />
        </div>

        <div class="photo-area">
          <img
            src={`${BASE_URL}images/nathan-photo.png`}
            alt="Nathan Charles Czapnik"
            class="nathan-photo"
          />
        </div>

      </div>

    </section>

    <section id="features" class="features">

      <article class="feature-card feature-pink">
        <h3>Dopasowane do Ciebie</h3>

        <p>
          Indywidualne zajęcia dopasowane do Twoich potrzeb,
          poziomu i celów.
        </p>

        <a href={`${BASE_URL}oferta`}>
          Dowiedz się więcej →
        </a>
      </article>

      <article class="feature-card feature-orange">
        <h3>Praktyczny angielski</h3>

        <p>
          Skupiam się na komunikacji, którą naprawdę wykorzystasz
          w pracy.
        </p>

        <a href={`${BASE_URL}oferta`}>
          Dowiedz się więcej →
        </a>
      </article>

      <article class="feature-card feature-sage">
        <h3>Elastycznie i bez stresu</h3>

        <p>
          Zajęcia online lub z dojazdem do ucznia —
          w dogodnym terminie.
        </p>

        <a href={`${BASE_URL}oferta`}>
          Dowiedz się więcej →
        </a>
      </article>

    </section>

    <section id="quote" class="quote-section">

      <div class="quote-mark">“</div>

      <blockquote>
        If the doors of perception were cleansed
        everything would appear to man as it is, Infinite.
      </blockquote>

      <p class="quote-author">
        William Blake
      </p>

    </section>

  </main>

  <footer class="footer">

    <div class="footer-item">

      <svg class="footer-svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"></path>
        <circle cx="12" cy="10" r="2.2"></circle>
      </svg>

      <span>Sandomierz, Polska</span>

    </div>

    <div class="footer-item">

      <svg class="footer-svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 3h3l1 5-2 1.5c1.5 3 3.5 5 6.5 6.5L17 14l4 2v3c0 1.1-.9 2-2 2C10.2 21 3 13.8 3 5c0-1.1.9-2 2-2h2Z"></path>
      </svg>

      <a href="tel:+48577970929">
        +48 577 970 929
      </a>

    </div>

    <div class="footer-item">

      <svg class="footer-svg" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="1"></rect>
        <path d="m4 7 8 6 8-6"></path>
      </svg>

      <a href="mailto:nathancharlesczapnik@gmail.com">
        nathancharlesczapnik@gmail.com
      </a>

    </div>

  </footer>

</Layout>